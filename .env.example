# Copy this file to .env and fill in values locally.
# Never commit .env or real credentials to the repository.

# Server
PORT=7000
NODE_ENV=production

# Local M3U file path (place your private channels.m3u in data/ folder)
CHANNELS_M3U_PATH=./data/channels.m3u

# Or remote private M3U URL
CHANNELS_M3U_URL=

# Stream Proxy (true = masks origin stream URL from users; false = direct stream redirect)
STREAM_PROXY_ENABLED=true

# Cache (TTL in seconds, 0 = disabled)
STREAM_CACHE_TTL_SECONDS=300
