# Copy this file to .env and fill in values locally.
# Never commit .env or real credentials to the repository.

# Server
PORT=7000
NODE_ENV=production

# Real-Debrid API Key (required for resolving debrid links)
REALDEBRID_TOKEN=your_realdebrid_api_token_here

# Stream Cache (TTL in seconds, 0 = disabled)
STREAM_CACHE_TTL_SECONDS=300
STREAM_CACHE_MAX_ENTRIES=500

# Provider Base URLs
# By default, Torrentio uses https://torrentio.strem.fun
# Set to "mock" for offline testing mode
# TORRENTIO_BASE_URL=mock

# BluDV and Torrent dos Filmes indexer endpoint (mibr-indexer container in docker-compose)
BLUDV_BASE_URL=http://mibr-indexer:7001
TORRENTDOSFILMES_BASE_URL=http://mibr-indexer:7001
